# AUDIX Production Environment Configuration Example
# Copy this file to .env for local/production deployments.

# Server Configuration
PORT=5000
FLASK_ENV=production
FLASK_DEBUG=false

# Security & CORS
JWT_SECRET=super-secret-jwt-key-change-in-production-audix-2026
CORS_ORIGINS=https://audix.app,http://localhost:5000,http://127.0.0.1:5000

# Database Configuration (PostgreSQL)
# Format: postgresql://user:password@host:port/dbname
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/recovery_db
PGHOST=localhost
PGPORT=5432
PGDATABASE=recovery_db
PGUSER=postgres
PGPASSWORD=postgres

# LLM Provider Configuration (Server-Side ONLY)
# Never expose LLM_API_KEY in frontend client code!
LLM_PROVIDER=gemini
LLM_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Rate Limiting Settings
RATE_LIMIT_PER_MINUTE=60
