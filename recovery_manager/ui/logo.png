<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 100" width="400" height="100">
  <defs>
    <linearGradient id="audixGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#3b82f6"/>
      <stop offset="50%" stop-color="#10b981"/>
      <stop offset="100%" stop-color="#06b6d4"/>
    </linearGradient>
    <filter id="glow" x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur stdDeviation="4" result="blur" />
      <feComposite in="SourceGraphic" in2="blur" operator="over"/>
    </filter>
  </defs>

  <!-- Logo Mark Icon -->
  <g transform="translate(10, 10)">
    <!-- Hexagonal Shield Outer -->
    <path d="M40 5 L75 25 L75 65 L40 85 L5 65 L5 25 Z" fill="none" stroke="url(#audixGrad)" stroke-width="4.5" stroke-linejoin="round" />
    
    <!-- Inner Node Graph / Audit Bolt -->
    <path d="M40 18 L55 35 L45 35 L58 62 L30 42 L40 42 Z" fill="url(#audixGrad)" filter="url(#glow)"/>
    
    <!-- Connected Evidence Nodes -->
    <circle cx="20" cy="30" r="3.5" fill="#3b82f6" />
    <circle cx="60" cy="30" r="3.5" fill="#10b981" />
    <circle cx="20" cy="60" r="3.5" fill="#06b6d4" />
    <circle cx="60" cy="60" r="3.5" fill="#3b82f6" />
    
    <line x1="20" y1="30" x2="40" y2="18" stroke="#3b82f6" stroke-width="1.5" stroke-dasharray="2 2" opacity="0.8"/>
    <line x1="60" y1="30" x2="40" y2="18" stroke="#10b981" stroke-width="1.5" stroke-dasharray="2 2" opacity="0.8"/>
    <line x1="20" y1="60" x2="30" y2="42" stroke="#06b6d4" stroke-width="1.5" stroke-dasharray="2 2" opacity="0.8"/>
    <line x1="60" y1="60" x2="58" y2="62" stroke="#3b82f6" stroke-width="1.5" stroke-dasharray="2 2" opacity="0.8"/>
  </g>

  <!-- Brand Text -->
  <text x="100" y="55" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif" font-weight="900" font-size="42" fill="#1e293b" letter-spacing="1">AUDIX</text>
  <text x="102" y="75" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif" font-weight="700" font-size="11" fill="#64748b" letter-spacing="3.5">RECOVERY INTELLIGENCE</text>
</svg>
